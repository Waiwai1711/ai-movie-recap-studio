[Unit]
Description=AI Movie Recap Studio FastAPI Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/AI_Movie_Recap_Studio/backend
EnvironmentFile=/opt/AI_Movie_Recap_Studio/.env
ExecStart=/opt/AI_Movie_Recap_Studio/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
