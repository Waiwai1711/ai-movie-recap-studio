# Security & Encryption
SECRET_KEY=replace_with_a_64_character_hex_random_key_in_production
ENCRYPTION_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
INVITE_ONLY=true
REGISTRATION_INVITE_CODE=BETAMONKEY2026

# Database & Storage
DATABASE_URL=sqlite:///./storage/recap_studio.db
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=524288000
MAX_STORAGE_PER_USER_BYTES=2147483648
MAX_SOURCE_DURATION_SEC=7200
MAX_OUTPUT_DURATION_SEC=900

# Concurrency
MAX_CONCURRENT_RENDERS_GLOBAL=2
MAX_CONCURRENT_RENDERS_PER_USER=1

# Optional Global Keys
ASSEMBLYAI_ADMIN_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MAINTENANCE_MODE=false
